# Copy this file to .env and fill in real values. Never commit .env.
# CI receives the same variables from GitHub repository secrets.

# Base URLs without a trailing slash.
STOREFRONT_URL=https://storefront.example.com
DASHBOARD_URL=https://dashboard.example.com
# Vendure server root. API clients append /shop-api or /admin-api.
API_URL=https://api.example.com

# Dedicated test accounts on a non-production environment.
# The storefront signs in by phone: 9 local digits, no leading zero, no dial code.
CUSTOMER_PHONE=9XXXXXXXX
CUSTOMER_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
